{
    "name": "exetazo/oe-module-grapheus",
    "description": "Grapheus by Exetazo: AI scribe for OpenEMR 8.x. Records the visit, then drafts the SOAP note, problems, allergies, prescriptions (entered, never sent) and fee-sheet codes (unbilled) for the clinician to review. Requires a paid Grapheus subscription.",
    "type": "openemr-module",
    "license": "GPL-3.0-or-later",
    "homepage": "https://scribe.exetazohealth.com",
    "authors": [
        {
            "name": "Exetazo Health",
            "email": "support@exetazohealth.com",
            "homepage": "https://scribe.exetazohealth.com",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "support@exetazohealth.com",
        "issues": "https://github.com/mikebirkheadmd-maker/oe-module-grapheus/issues",
        "source": "https://github.com/mikebirkheadmd-maker/oe-module-grapheus",
        "docs": "https://github.com/mikebirkheadmd-maker/oe-module-grapheus#readme"
    },
    "keywords": [
        "openemr",
        "openemr-module",
        "ai scribe",
        "ambient documentation",
        "grapheus",
        "clinical documentation",
        "soap note",
        "medical coding"
    ],
    "autoload": {
        "psr-4": {
            "Exetazo\\Grapheus\\": "src/"
        }
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "openemr/oe-module-installer-plugin": "^0.1"
    },
    "config": {
        "allow-plugins": {
            "openemr/oe-module-installer-plugin": true
        }
    },
    "conflict": {
        "openemr/openemr": "~7.0.0"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        }
    }
}
